{
  "name": "agent-sparring-vscode",
  "displayName": "Agent Sparring",
  "description": "Observe, launch and navigate agent-sparring plan runs from VS Code.",
  "version": "0.1.0",
  "publisher": "sintef",
  "private": true,
  "license": "MIT",
  "icon": "icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sigmundas/agent-sparring-vscode.git"
  },
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "icons/icon.png",
    "docs/Screenshot 2026-10-07 at 13.09.32.png",
    "docs/README.md",
    "docs/setup.md",
    "docs/commands.md",
    "docs/configuration.md",
    "docs/workflows.md",
    "docs/runs.md",
    "docs/state.md",
    "docs/runners.md",
    "docs/development.md",
    "README.md",
    "LICENSE"
  ],
  "activationEvents": [
    "workspaceContains:.sparring",
    "workspaceContains:.sparring/project.toml",
    "workspaceContains:.sparring/plans/*.json",
    "workspaceContains:**/.sparring/project.toml",
    "workspaceContains:**/.sparring/stages/*/state.json",
    "onView:agentSparring.runs"
  ],
  "contributes": {
    "commands": [
