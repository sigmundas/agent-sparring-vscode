        "command": "agentSparring.runPlan",
        "title": "Run Plan",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.makePlan",
        "title": "Make Plan…",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.resumePlan",
        "title": "Resume Plan",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.mergeCleanUp",
        "title": "Merge & Clean Up Run",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.openOverview",
        "title": "Open Overview",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.confirmRunnerInactive",
        "title": "Confirm Previous Runner Is No Longer Active",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.openSettings",
        "title": "Open Project Settings",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.showLog",
        "title": "Show Log",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.selectRun",
        "title": "Select Repository / Run",
        "category": "Agent Sparring",
        "icon": "$(list-selection)"
      },
      {
        "command": "agentSparring.followActiveRepository",
        "title": "Follow Active Repository",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.chooseRepository",
        "title": "Choose Repository to Follow",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.cleanUpRunnerTerminals",
        "title": "Clean Up Terminals",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.followActiveEditor",
        "title": "Follow Active Editor",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.refresh",
        "title": "Rediscover State",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.diagnoseDiscovery",
        "title": "Diagnose Discovery",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.runStage",
        "title": "Run / Resume Stage",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.acceptStage",
        "title": "Accept Stage",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.choosePlan",
        "title": "Choose Plan for Stage…",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.matchStage",
        "title": "Match Stage to Plan Section…",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.startNextStage",
        "title": "Start Next Stage from Plan…",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.continueAutomatically",
        "title": "Continue Plan Automatically",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.allowPush",
        "title": "Allow Push of the Verified Candidate",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.reviewStageMatches",
        "title": "Review Stage Matches…",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.stageRepositories",
        "title": "Sibling Repositories for a Plan Stage…",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.stageMode",
        "title": "Stage Mode for a Plan Stage…",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.copyReviewContext",
        "title": "Copy Review Context for Chat",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.chooseExecutable",
        "title": "Choose sparring Executable…",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.runs.follow",
        "title": "Show in Overview",
        "category": "Agent Sparring",
        "icon": "$(eye)"
      },
      {
        "command": "agentSparring.runs.openWorktree",
        "title": "Open Worktree in New Window",
        "category": "Agent Sparring",
        "icon": "$(empty-window)"
      },
      {
        "command": "agentSparring.runs.copyRunId",
        "title": "Copy Run Key",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.runs.refresh",
        "title": "Refresh Runs",
        "category": "Agent Sparring",
        "icon": "$(refresh)"
      },
      {
        "command": "agentSparring.runs.showOlder",
        "title": "Show Older Runs",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.runs.showRecent",
        "title": "Show Recent Runs Only",
        "category": "Agent Sparring"
      }
    ],
    "configuration": {
      "title": "Agent Sparring",
      "properties": {
        "agentSparring.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "Full path to the `sparring` executable. Leave empty to let your integrated shell resolve `sparring` from its own `PATH` (the same way it does when you type the command). Set it when the shell reports the command as not found, or when terminal shell integration is unavailable."
        },
        "agentSparring.planContinuation": {
          "type": "string",
          "enum": [
            "automatic",
            "manual"
          ],
          "default": "automatic",
          "enumDescriptions": [
            "Hand the whole plan to the engine as one managed run. It continues from stage to stage on its own and stops when it needs you.",
            "Keep the explicit per-stage checkpoints: Accept stage, Start next stage, Run stage."
          ],
          "markdownDescription": "How a plan progresses.\n\n**Continue automatically** (default) builds an execution manifest from the plan and starts the engine's own managed run (`sparring run-plan --manifest …`). The engine sequences the stages, accepts each READY candidate through its existing hard gate, and stops at NEEDS_YOU, an escalation, a failure, or the end of the plan. You confirm once, at the start — never between stages.\n\n**Pause after each stage** keeps the per-stage actions, for when you want a checkpoint before every provider turn. Both modes only ever run engine operations; the extension never sequences stages itself."
        },
        "agentSparring.pollIntervalMs": {
          "type": "number",
          "default": 1500,
          "minimum": 250,
          "description": "Fallback polling interval for activity.jsonl when filesystem events are missed."
        },
        "agentSparring.nestedSearchDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 4,
          "markdownDescription": "How many directory levels below each workspace folder are searched for nested projects with their own `.sparring` (for example a git worktree or a monorepo package checked out under a parent folder). `0` probes only the workspace folders themselves. Hidden and dependency/build directories are never entered."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentSparring",
          "title": "Agent Sparring",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "agentSparring": [
        {
          "id": "agentSparring.runs",
          "name": "Runs",
          "contextualTitle": "Agent Sparring"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agentSparring.runs.refresh",
          "when": "view == agentSparring.runs",
          "group": "navigation"
        },
        {
          "command": "agentSparring.selectRun",
          "when": "view == agentSparring.runs",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "agentSparring.runs.follow",
          "when": "view == agentSparring.runs && viewItem =~ /^run/",
          "group": "inline"
        },
        {
          "command": "agentSparring.runs.follow",
          "when": "view == agentSparring.runs && viewItem =~ /^run/",
          "group": "1_open@1"
        },
        {
          "command": "agentSparring.runs.openWorktree",
          "when": "view == agentSparring.runs && viewItem =~ /^run\\.external/",
          "group": "1_open@2"
        },
        {
          "command": "agentSparring.runs.copyRunId",
          "when": "view == agentSparring.runs && viewItem =~ /^run/",
          "group": "2_copy"
        }
      ],
      "commandPalette": [
        {
          "command": "agentSparring.runs.follow",
          "when": "false"
        },
        {
          "command": "agentSparring.runs.openWorktree",
          "when": "false"
        },
        {
          "command": "agentSparring.runs.copyRunId",
          "when": "false"
        },
        {
          "command": "agentSparring.runs.showOlder",
          "when": "false"
        },
        {
          "command": "agentSparring.runs.showRecent",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run typecheck && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "watch": "npm run bundle -- --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test": "npm run compile-tests && node --test \"out/test/**/*.test.js\"",
    "test:parity": "npm run compile-tests && node --test out/test/manifestParity.test.js",
    "compile-integration": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run bundle && npm run compile-integration && node out/integration/runTests.js && node out/integration/runFreshWorkspace.js && node out/integration/runWorktreeRuns.js",
    "test:smoke": "npm run bundle && npm run compile-integration && AGENT_SPARRING_VSCODE_VERSION=1.93.1 node out/integration/runFreshWorkspace.js && AGENT_SPARRING_VSCODE_VERSION=stable node out/integration/runFreshWorkspace.js",
    "lint": "eslint src",
    "vscode:prepublish": "npm run build",
    "package:vsix": "vsce package --no-dependencies",
    "check:vsix": "node scripts/check-vsix.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.93.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.23.0",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  },
  "keywords": [
    "agent-sparring",
    "claude",
    "codex",
    "orchestration"
  ]
}
