{
  "name": "agent-sparring-vscode",
  "displayName": "Agent Sparring",
  "description": "Observe, launch and navigate agent-sparring plan runs from VS Code.",
  "version": "0.1.0",
  "publisher": "sintef",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.sparring",
    "workspaceContains:.sparring/project.toml",
    "workspaceContains:.sparring/plans/*.json",
    "workspaceContains:**/.sparring/project.toml",
    "workspaceContains:**/.sparring/stages/*/state.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentSparring.runPlan",
        "title": "Run Plan",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.resumePlan",
        "title": "Resume Plan",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.openOverview",
        "title": "Open Overview",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.showLog",
        "title": "Show Log",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.selectRun",
        "title": "Select Repository / Run",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.refresh",
        "title": "Rediscover State",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.diagnoseDiscovery",
        "title": "Diagnose Discovery",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.runStage",
        "title": "Run / Resume Stage",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.acceptStage",
        "title": "Accept Stage",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.choosePlan",
        "title": "Choose Plan for Stage…",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.matchStage",
        "title": "Match Stage to Plan Section…",
        "category": "Agent Sparring"
      },
      {
        "command": "agentSparring.chooseExecutable",
        "title": "Choose sparring Executable…",
        "category": "Agent Sparring"
      }
    ],
    "configuration": {
      "title": "Agent Sparring",
      "properties": {
        "agentSparring.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "Full path to the `sparring` executable. Leave empty to let your integrated shell resolve `sparring` from its own `PATH` (the same way it does when you type the command). Set it when the shell reports the command as not found, or when terminal shell integration is unavailable."
        },
        "agentSparring.pollIntervalMs": {
          "type": "number",
          "default": 1500,
          "minimum": 250,
          "description": "Fallback polling interval for activity.jsonl when filesystem events are missed."
        },
        "agentSparring.nestedSearchDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 4,
          "markdownDescription": "How many directory levels below each workspace folder are searched for nested projects with their own `.sparring` (for example a git worktree or a monorepo package checked out under a parent folder). `0` probes only the workspace folders themselves. Hidden and dependency/build directories are never entered."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run typecheck && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "watch": "npm run bundle -- --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test": "npm run compile-tests && node --test \"out/test/**/*.test.js\"",
    "compile-integration": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run bundle && npm run compile-integration && node out/integration/runTests.js",
    "lint": "eslint src",
    "vscode:prepublish": "npm run build",
    "package:vsix": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.23.0",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  },
  "keywords": [
    "agent-sparring",
    "claude",
    "codex",
    "orchestration"
  ]
}
